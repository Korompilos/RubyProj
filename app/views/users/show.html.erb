<div class="portal-container">
  <div class="post-card shadow-sm" style="max-width: 700px; margin: 0 auto; border-radius: 16px; background: white;">
    <div class="p-4 border-bottom d-flex align-items-center">
      <% if @user %>
        <div class="user-badge me-3 text-white" style="background: var(--bg-gradient);"><%= @user.email[0].upcase %></div>
        <h4 class="mb-0 fw-bold text-primary">Συνομιλία με <%= @user.email %></h4>
      <% end %>
    </div>

    <%= turbo_stream_from @single_room %>

    <div id="messages_scroll" style="height: 400px; overflow-y: auto; padding: 20px; background: #f8fafc;">
      <div id="messages">
        <% @messages.each do |msg| %>
          <%= render partial: 'messages/message', locals: { message: msg, session_user_id: current_user.id } %>
        <% end %>
      </div>
    </div>

    <div class="p-4 border-top">
      <%= form_with(model: [@single_room, @message], remote: true, class: "d-flex gap-2") do |f| %>
        <%= f.text_field :content, placeholder: "Γράψτε κάτι...", class: "form-control rounded-pill px-4" %>
        <%= f.submit "Στείλε", class: "btn btn-primary rounded-pill px-4" %>
      <% end %>
    </div>
  </div>
</div>