<div class="portal-container">
  <div class="post-card shadow-sm" style="max-width: 750px; margin: 0 auto; border-radius: 20px; background: white; border: none; overflow: hidden;">
    
    <div class="p-4 border-bottom bg-white d-flex align-items-center justify-content-between">
      <div class="d-flex align-items-center">
        <div class="user-badge me-3 shadow-sm" style="background: var(--bg-gradient); color: white; width: 50px; height: 50px; font-size: 1.2rem; display: flex; align-items: center; justify-content: center; border-radius: 50%;">
          <% if @single_room.users.count > 2 %>
            <i class="bi bi-people-fill"></i>
          <% else %>
            <% other_user = @user || @single_room.users.where.not(id: current_user.id).first %>
            <%= other_user&.email&.at(0)&.upcase %>
          <% end %>
        </div>
        
        <div>
          <h4 class="mb-0 fw-bold text-dark">
            <% if @single_room.users.count > 2 %>
              Group chat
            <% else %>
              <% other_user = @user || @single_room.users.where.not(id: current_user.id).first %>
              Chat with <%= other_user&.email %>
            <% end %>
          </h4>
          <small class="text-muted">
            <i class="bi bi-person-check-fill me-1 text-success"></i>
            <%= @single_room.users.map { |u| u.email.split('@').first }.join(", ") %>
          </small>
        </div>
      </div>

      <%= link_to my_friends_path, class: "btn btn-light btn-sm rounded-circle shadow-sm", title: "Back to my contacts" do %>
        <i class="bi bi-chevron-left"></i>
      <% end %>
    </div>

    <%# Real-time Messages Area %>
    <%= turbo_stream_from @single_room %>
    
    <div id="messages_scroll_container" 
         style="height: 500px; overflow-y: auto; padding: 25px; background-color: #f8fafc; scroll-behavior: smooth;">
      
      <div id="messages">
        <% @messages.each do |msg| %>
          <%= render partial: 'messages/message', locals: { message: msg, session_user_id: current_user.id } %>
        <% end %>
      </div>
    </div>

    <div id="message_form_container" class="p-4 border-top bg-white">
      <%= render partial: 'messages/form', locals: { room: @single_room, message: @message } %>
    </div>
  </div>
</div>

<style>
  #messages_scroll_container::-webkit-scrollbar {
    width: 6px;
  }
  #messages_scroll_container::-webkit-scrollbar-track {
    background: transparent;
  }
  #messages_scroll_container::-webkit-scrollbar-thumb {
    background: #cbd5e1;
    border-radius: 10px;
  }
  .animate-fadeIn {
    animation: fadeIn 0.3s ease-in;
  }
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(5px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>