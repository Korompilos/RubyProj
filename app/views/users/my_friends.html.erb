<div class="portal-container">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0 fw-bold">My Contacts</h2>
    <% if @friends.any? %>
      <span class="badge bg-primary rounded-pill px-3"><%= @friends.count %> Friends</span>
    <% end %>
  </div>

  <% if @friends.any? %>
    <%= form_with url: rooms_path, method: :post, id: "group-chat-form", html: { style: "display:none;" } do |f| %>
    <% end %>

    <div class="posts-feed">
      <% @friends.each do |friend| %>
        <div class="post-card shadow-sm border-0 mb-3 p-3 animate-fadeIn" style="display: flex; align-items: center; justify-content: space-between; background: white; border-radius: 16px;">
          
          <div style="display: flex; align-items: center; gap: 15px;">
            <div class="form-check">
              <%= check_box_tag "user_ids[]", friend.id, false, class: "form-check-input", form: "group-chat-form", style: "width: 22px; height: 22px; cursor: pointer;" %>
            </div>
            
            <div class="user-badge shadow-sm" style="background: var(--bg-gradient); color: white; width: 45px; height: 45px; display: flex; align-items: center; justify-content: center; border-radius: 50%; font-weight: bold;">
              <%= friend.email[0].upcase %>
            </div>
            
            <div>
              <strong class="d-block text-dark"><%= friend.email %></strong>
              <div style="font-size: 0.8rem; color: #28a745;">● Online</div>
            </div>
          </div>
          
          <div style="display: flex; gap: 10px; align-items: center;">
            <%# Message Button %>
            <%= link_to user_path(friend), class: "btn btn-primary btn-sm rounded-pill px-3 text-decoration-none shadow-sm" do %>
              <i class="bi bi-chat-fill"></i> Message
            <% end %>
            
            <% friendship = current_user.friendships.find_by(friend_id: friend.id) %>
            
            <% if friendship %>
              <%= button_to friendship_path(friendship), method: :delete, form: { style: "display:inline-block;" }, class: "btn btn-outline-danger btn-sm rounded-pill px-3 shadow-sm text-decoration-none", data: { confirm: "Are you sure?" } do %>
                <i class="bi bi-person-x-fill"></i> Remove
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>

    <div class="sticky-bottom bg-white p-3 border-top mt-4 shadow-lg rounded-4 d-flex justify-content-between align-items-center" style="z-index: 1050;">
      <div class="ps-2">
        <h6 class="mb-0 fw-bold text-primary">Create Group Chat</h6>
        <small class="text-muted">Select 2 or 3 friends (chat with max 4 people)</small>
      </div>
      <button type="submit" form="group-chat-form" class="btn btn-success rounded-pill px-5 fw-bold shadow">
        Create Group Chat
      </button>
    </div>

  <% else %>
    <div class="post-card shadow-sm text-center p-5" style="background: white; border-radius: 20px;">
      <h4 class="mt-3 fw-bold">No contacts...</h4>
      <%= link_to "Discover Friends", find_friends_path, class: "btn btn-primary rounded-pill mt-2" %>
    </div>
  <% end %>
</div>