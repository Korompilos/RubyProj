<div id="<%= dom_id message %>" 
     style="display: flex; justify-content: <%= message.user_id == session_user_id ? 'flex-end' : 'flex-start' %>; margin-bottom: 10px;">
  
  <div style="padding: 10px; border-radius: 15px; background: <%= message.user_id == session_user_id ? '#007bff; color: white;' : '#eee;' %>; position: relative;">
    <%= message.content %>

    <% if message.user_id == session_user_id %>
      <%= link_to "×", room_message_path(message.room, message), 
          data: { turbo_method: :delete, turbo_confirm: "Διαγραφή μηνύματος;" }, 
          style: "margin-left: 10px; color: white; text-decoration: none; font-weight: bold; cursor: pointer;" %>
    <% end %>
  </div>
</div>