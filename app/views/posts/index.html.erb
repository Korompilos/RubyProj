<div class="portal-container">
  
  <h1>Lab Manager Portal</h1>

  <!-- Search Bar -->
  <div class="search-bar">
    <%= form_with url: posts_path, method: :get, local: true, class: "flex-search" do |f| %>
      <%= f.text_field :query, 
          placeholder: "Search text in posts...", 
          value: params[:query], 
          class: "search-input" %>
      
      <%= f.select :category, 
          @lessons, 
          { include_blank: "All Courses", selected: params[:category] }, 
          { class: "search-select" } %>
      
      <button type="submit" class="search-btn">
        Search
      </button>
      
      <% if params[:query].present? || params[:category].present? %>
        <%= link_to "Clear", posts_path, class: "clear-link" %>
      <% end %>
    <% end %>
  </div>

  <!-- New Post Card -->
  <div class="new-post-card">
    <h3>What are you thinking?</h3>
    <%= form_with(model: @post) do |f| %>
      <%= f.text_area :content, 
          placeholder: "Share your thought...", 
          rows: 4 %>
      
      <div class="post-actions">
        <%= f.select :category, 
            @lessons, 
            { prompt: "Select Course" }, 
            { class: "styled-select" } %>
        
        <%= f.submit "Post", class: "btn-primary" %>
      </div>
    <% end %>
  </div>

  <!-- Posts Feed -->
  <div class="posts-feed">
    <% if @posts.any? %>
      <% @posts.each do |post| %>
        <div class="post-card">
          <!-- Post Header -->
          <div class="post-header">
            <div class="user-badge">
              <%= post.user.email[0].upcase %>
            </div>
            <div class="user-info">
              <strong><%= post.user.email.split('@').first %></strong>
              <small>🕐 <%= time_ago_in_words(post.created_at) %> πριν</small>
            </div>
            <span class="category-tag">
              <%= post.category %>
            </span>
          </div>
          
          <!-- Post Body -->
          <div class="post-body">
            <%= simple_format(post.content) %>
          </div>

          <!-- Post Actions (Edit/Delete) -->
          <% if post.user == current_user %>
            <div class="post-actions-buttons">
              <%= link_to "Edit", edit_post_path(post), class: "btn-edit" %>
              <%= button_to "Delete", 
                  post_path(post), 
                  method: :delete, 
                  data: { confirm: "Are you sure?" }, 
                  class: "btn-delete" %>
            </div>
          <% end %>
        </div>
      <% end %>
    <% else %>
      <div class="empty-state">
        <h3>📭 No posts yet...</h3>
        <p>Be the first to post!</p>
      </div>
    <% end %>
  </div>

</div>
