<h1>Lab Manager Portal</h1>

<%= form_with(model: @post) do |f| %>
  <%= f.text_area :content, placeholder: "Write something..." %>
  
  <label>Select Course:</label>
  <%= f.select :category, @lessons %>
  
  <%= f.submit "Post" %>
<% end %>

<hr>

<% @posts.each do |p| %>
  <div style="border: 1px solid #ddd; padding: 10px; margin-bottom: 5px;">
    <strong><%= p.category %></strong> - <small><%= p.user.email %></small>
    <p><%= p.content %></p>
    
    <% if p.user == current_user %>
      <%= link_to "Edit", edit_post_path(p) %> |
      <%= button_to "Delete", post_path(p), method: :delete, data: { confirm: "Are you sure?" } %>
    <% end %>
  </div>
<% end %>